{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hhhaven:delivery:1",
  "title": "Healthy Habits Haven: Lieferung von Claude, Fassung 1",
  "description": "Form, Typen, Grenzen und Zeichenregeln. Bezüge, Dubletten, Kalenderdatum und Gesamtdauer prüft nur der Referenz-Prüfer (Contracts/validator). Spec: openspec/specs/integrations/claude-lieferformat.md",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "deliveryId",
    "source",
    "createdAt",
    "why",
    "items"
  ],
  "properties": {
    "format": {
      "const": "hhhaven.delivery/1"
    },
    "deliveryId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{7,63}$"
    },
    "source": {
      "const": "claude"
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
    },
    "why": {
      "$ref": "#/$defs/text300"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageId",
        "name"
      ],
      "properties": {
        "packageId": {
          "$ref": "#/$defs/itemId"
        },
        "name": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "itemId": {
      "type": "string",
      "pattern": "^claude\\.[a-z0-9][a-z0-9-]{1,62}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "allOf": [
        {
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F  ‪-‮⁦-⁩]*$"
        },
        {
          "pattern": "[^ \\u00A0\\n]"
        }
      ]
    },
    "text300": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "allOf": [
        {
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F  ‪-‮⁦-⁩]*$"
        },
        {
          "pattern": "[^ \\u00A0\\n]"
        }
      ]
    },
    "hint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "allOf": [
        {
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F  ‪-‮⁦-⁩]*$"
        },
        {
          "pattern": "[^ \\u00A0\\n]"
        }
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "allOf": [
        {
          "pattern": "^[^\\u0000-\\u0009\\u000B-\\u001F\\u007F-\\u009F  ‪-‮⁦-⁩]*$"
        },
        {
          "pattern": "[^ \\u00A0\\n]"
        }
      ]
    },
    "symbol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F  ‪-‮⁦-⁩ \\u00A0A-Za-z0-9]+$"
    },
    "item": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "exercise",
            "program",
            "breath",
            "reminder",
            "withdrawal"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "exercise"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/exercise"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "program"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/program"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "breath"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/breath"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "reminder"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/reminder"
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "withdrawal"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/withdrawal"
          }
        }
      ]
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "itemId",
        "revision",
        "name",
        "category",
        "effect",
        "instructions"
      ],
      "properties": {
        "kind": {
          "const": "exercise"
        },
        "itemId": {
          "$ref": "#/$defs/itemId"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "nameEn": {
          "$ref": "#/$defs/name"
        },
        "category": {
          "enum": [
            "strength",
            "stretching",
            "core",
            "cardio",
            "legs",
            "upperBody",
            "fullBody",
            "warmup",
            "cooldown"
          ]
        },
        "effect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "allOf": [
            {
              "pattern": "^[^\\u0000-\\u0009\\u000B-\\u001F\\u007F-\\u009F  ‪-‮⁦-⁩]*$"
            },
            {
              "pattern": "[^ \\u00A0\\n]"
            }
          ]
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500,
          "allOf": [
            {
              "pattern": "^[^\\u0000-\\u0009\\u000B-\\u001F\\u007F-\\u009F  ‪-‮⁦-⁩]*$"
            },
            {
              "pattern": "[^ \\u00A0\\n]"
            }
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "allOf": [
            {
              "pattern": "^[^\\u0000-\\u0009\\u000B-\\u001F\\u007F-\\u009F  ‪-‮⁦-⁩]*$"
            },
            {
              "pattern": "[^ \\u00A0\\n]"
            }
          ]
        }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "itemId",
        "revision",
        "name",
        "symbol",
        "rounds",
        "steps"
      ],
      "properties": {
        "kind": {
          "const": "program"
        },
        "itemId": {
          "$ref": "#/$defs/itemId"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "symbol": {
          "$ref": "#/$defs/symbol"
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exerciseId",
        "workSeconds",
        "restSeconds"
      ],
      "properties": {
        "exerciseId": {
          "type": "string",
          "pattern": "^(builtin|own|claude)\\.[a-z0-9][a-z0-9-]{1,62}$"
        },
        "workSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "restSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        },
        "hint": {
          "$ref": "#/$defs/hint"
        }
      }
    },
    "breath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "itemId",
        "revision",
        "name",
        "symbol",
        "inhaleSeconds",
        "holdInSeconds",
        "exhaleSeconds",
        "holdOutSeconds",
        "rounds"
      ],
      "properties": {
        "kind": {
          "const": "breath"
        },
        "itemId": {
          "$ref": "#/$defs/itemId"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "symbol": {
          "$ref": "#/$defs/symbol"
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "inhaleSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "holdInSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "exhaleSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "holdOutSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        }
      }
    },
    "withdrawal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "withdrawal"
        },
        "itemId": {
          "$ref": "#/$defs/itemId"
        },
        "packageId": {
          "$ref": "#/$defs/itemId"
        }
      },
      "oneOf": [
        {
          "required": [
            "itemId"
          ],
          "not": {
            "required": [
              "packageId"
            ]
          }
        },
        {
          "required": [
            "packageId"
          ],
          "not": {
            "required": [
              "itemId"
            ]
          }
        }
      ]
    },
    "reminder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "itemId",
        "revision",
        "title",
        "message",
        "time",
        "weekdays",
        "lookbackHours",
        "target"
      ],
      "properties": {
        "kind": {
          "const": "reminder"
        },
        "itemId": {
          "$ref": "#/$defs/itemId"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "title": {
          "$ref": "#/$defs/name"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "allOf": [
            {
              "pattern": "^[^\\u0000-\\u0009\\u000B-\\u001F\\u007F-\\u009F  ‪-‮⁦-⁩]*$"
            },
            {
              "pattern": "[^ \\u00A0\\n]"
            }
          ]
        },
        "time": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "weekdays": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "monday",
              "tuesday",
              "wednesday",
              "thursday",
              "friday",
              "saturday",
              "sunday"
            ]
          }
        },
        "lookbackHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "target": {
          "$ref": "#/$defs/reminderTarget"
        }
      }
    },
    "reminderTarget": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "meditation",
            "workout",
            "breath",
            "noalc"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "meditation"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "properties": {
              "type": {}
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "noalc"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "properties": {
              "type": {}
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "workout"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "properties": {
              "type": {},
              "programId": {
                "type": "string",
                "pattern": "^(builtin|own|claude)\\.[a-z0-9][a-z0-9-]{1,62}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "breath"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "breathId"
            ],
            "properties": {
              "type": {},
              "breathId": {
                "type": "string",
                "pattern": "^(builtin|own|claude)\\.[a-z0-9][a-z0-9-]{1,62}$"
              }
            }
          }
        }
      ]
    }
  }
}
